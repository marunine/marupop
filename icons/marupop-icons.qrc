  <qresource prefix="/marupop/icons">
    <file>16-apps-io.github.marunine.marupop.svg</file>
    <file>22-apps-io.github.marunine.marupop.svg</file>
    <file>32-apps-io.github.marunine.marupop.svg</file>
    <file>48-apps-io.github.marunine.marupop.svg</file>
    <file>sc-apps-io.github.marunine.marupop.svg</file>
    <file>16-apps-io.github.marunine.marupop-paused.svg</file>
    <file>22-apps-io.github.marunine.marupop-paused.svg</file>
    <file>32-apps-io.github.marunine.marupop-paused.svg</file>
    <file>48-apps-io.github.marunine.marupop-paused.svg</file>
    <file>sc-apps-io.github.marunine.marupop-paused.svg</file>
  </qresource>
</RCC>
